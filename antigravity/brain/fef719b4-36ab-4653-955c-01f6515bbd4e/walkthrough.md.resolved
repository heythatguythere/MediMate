  </aside>

  <!-- Main Content -->
  <main class="main" id="main-content">

    <!-- ════════════ DASHBOARD VIEW ════════════ -->
    <section class="view active" id="view-dashboard">
      <div class="view__header">
        <div>
          <h1 class="view__title">Threat Dashboard</h1>
          <p class="view__subtitle">Real-time phishing detection overview</p>
        </div>
        <div class="view__actions">
          <button class="btn btn--outline btn--sm" onclick="resetStats()" id="reset-stats-btn">Reset Stats</button>
        </div>
      </div>

      <div class="stats-row">
        <div class="stat-card" id="stat-card-scanned">
          <div class="stat-card__top">
            <span class="stat-card__label">Scanned</span>
            <div class="stat-card__icon stat-card__icon--blue">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            </div>
          </div>
          <div class="stat-card__value" id="stat-scanned">0</div>
          <div class="stat-card__bar"><div class="stat-card__bar-fill stat-card__bar-fill--blue" style="width:0%"></div></div>
        </div>

        <div class="stat-card" id="stat-card-threats">
          <div class="stat-card__top">
            <span class="stat-card__label">Threats</span>
            <div class="stat-card__icon stat-card__icon--red">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            </div>
          </div>
          <div class="stat-card__value" id="stat-threats">0</div>
          <div class="stat-card__bar"><div class="stat-card__bar-fill stat-card__bar-fill--red" style="width:0%"></div></div>
        </div>

        <div class="stat-card" id="stat-card-suspicious">
          <div class="stat-card__top">
            <span class="stat-card__label">Suspicious</span>
            <div class="stat-card__icon stat-card__icon--amber">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            </div>
          </div>
          <div class="stat-card__value" id="stat-suspicious">0</div>
          <div class="stat-card__bar"><div class="stat-card__bar-fill stat-card__bar-fill--amber" style="width:0%"></div></div>
        </div>

        <div class="stat-card" id="stat-card-safe">
          <div class="stat-card__top">
            <span class="stat-card__label">Safe</span>
            <div class="stat-card__icon stat-card__icon--green">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            </div>
          </div>
          <div class="stat-card__value" id="stat-safe">0</div>
          <div class="stat-card__bar"><div class="stat-card__bar-fill stat-card__bar-fill--green" style="width:0%"></div></div>
        </div>
      </div>

      <!-- Threat Distribution -->
      <div class="panel">
        <div class="panel__header">
          <h2 class="panel__title">Threat Distribution</h2>
        </div>
        <div class="panel__body">
          <div class="threat-chart" id="threat-chart">
            <div class="threat-chart__empty">No scan data yet. Run Gmail Scanner or Analyze an email to see results.</div>
          </div>
        </div>
      </div>

      <!-- Recent Results -->
      <div class="panel">
        <div class="panel__header">
          <h2 class="panel__title">Recent Results</h2>
          <span class="panel__count" id="recent-count">0 emails</span>
        </div>
        <div class="panel__body" id="recent-results">
          <div class="empty-state">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
            </svg>
            <p>Scan emails to see results here</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════ ANALYZE VIEW ════════════ -->
    <section class="view" id="view-analyze">
      <div class="view__header">
        <div>
          <h1 class="view__title">Email Analyzer</h1>
          <p class="view__subtitle">Paste raw email content (including headers) for analysis</p>
        </div>
      </div>

      <div class="analyze-grid">
        <div class="panel analyze-input-panel">
          <div class="panel__header">
            <h2 class="panel__title">Raw Email Input</h2>
            <button class="btn btn--outline btn--sm" id="load-sample-btn">Load Sample</button>
          </div>
          <div class="panel__body">
            <textarea class="analyze-textarea" id="email-input" placeholder="Paste raw email here including headers...&#10;&#10;From: sender@example.com&#10;Reply-To: different@example.com&#10;Subject: Urgent: Verify your account&#10;&#10;Dear Customer, click here to verify..."></textarea>
            <div class="analyze-actions">
              <button class="btn btn--primary" id="analyze-btn">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
                <span>Analyze Email</span>
              </button>
              <button class="btn btn--ghost btn--sm" id="clear-input-btn">Clear</button>
            </div>
          </div>
        </div>

        <div class="panel analyze-result-panel">
          <div class="panel__header">
            <h2 class="panel__title">Analysis Result</h2>
          </div>
          <div class="panel__body" id="analyze-result">
            <div class="empty-state">
              <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
              </svg>
              <p>Paste an email and click Analyze to see results</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ════════════ GMAIL VIEW ════════════ -->
    <section class="view" id="view-gmail">
      <div class="view__header">
        <div>
          <h1 class="view__title">Gmail Scanner</h1>
          <p class="view__subtitle">Scan your Gmail inbox for phishing threats via OAuth</p>
        </div>
        <div class="view__actions">
          <label class="select-label" for="email-count">Emails:</label>
          <select id="email-count" class="select">
            <option value="5">5</option>
            <option value="10" selected>10</option>
            <option value="20">20</option>
            <option value="50">50</option>
          </select>
          <button class="btn btn--primary" id="scan-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
            <span>Scan Inbox</span>
          </button>
        </div>
      </div>

      <div class="panel">
        <div class="panel__body" id="gmail-body">
          <div class="empty-state" id="gmail-empty">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
            </svg>
            <p>Click <strong>Scan Inbox</strong> to fetch and analyze your recent Gmail emails</p>
            <p class="empty-state__hint">Requires Gmail OAuth — a browser window will open on first use</p>
          </div>
          <div id="gmail-list" class="email-list"></div>
        </div>
      </div>
    </section>

    <!-- ════════════ ENGINES VIEW ════════════ -->
    <section class="view" id="view-engines">
      <div class="view__header">
        <div>
          <h1 class="view__title">Detection Engines</h1>
          <p class="view__subtitle">20 rule-based engines — deterministic, explainable, zero ML</p>
        </div>
      </div>

      <div class="engines-filter">
        <button class="filter-btn active" data-filter="all">All (20)</button>
        <button class="filter-btn" data-filter="header">Header Analysis</button>
        <button class="filter-btn" data-filter="domain">Domain Intelligence</button>
        <button class="filter-btn" data-filter="content">Content Analysis</button>
        <button class="filter-btn" data-filter="reputation">Reputation Checks</button>
      </div>

      <div class="engines-grid" id="engines-grid">
        <!-- Populated by JS -->
      </div>
    </section>

  </main>

  <!-- Mobile sidebar toggle -->
  <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle menu">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/>
    </svg>
  </button>

  <script src="/static/script.js"></script>
</body>
</html>

```

1. **Dashboard** — Stats cards, threat distribution bar chart, recent scan results
2. **Analyze Email** — Manual raw email paste → detailed verdict card with engine breakdown
3. **Gmail Scanner** — OAuth-based inbox scanning with expandable result cards
4. **Detection Engines** — All 20 engines with descriptions, filterable by category

### [style.css](file:///Users/david/fish/static/style.css) — Command Center Design

```diff:style.css
/* ============================================
   PHISHING DETECTOR — PREMIUM DASHBOARD CSS
   ============================================ */

@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap');

/* ---------- Design Tokens ---------- */
:root {
  /* Background */
  --bg-primary: #0a0e1a;
  --bg-secondary: #111827;
  --bg-card: rgba(17, 24, 39, 0.6);
  --bg-card-hover: rgba(17, 24, 39, 0.8);
  --bg-input: rgba(15, 23, 42, 0.8);

  /* Text */
  --text-primary: #f1f5f9;
  --text-secondary: #94a3b8;
  --text-muted: #64748b;

  /* Accents */
  --accent-blue: #3b82f6;
  --accent-blue-glow: rgba(59, 130, 246, 0.25);
  --accent-emerald: #10b981;
  --accent-emerald-glow: rgba(16, 185, 129, 0.2);
  --accent-amber: #f59e0b;
  --accent-amber-glow: rgba(245, 158, 11, 0.2);
  --accent-rose: #f43f5e;
  --accent-rose-glow: rgba(244, 63, 94, 0.2);
  --accent-purple: #a855f7;

  /* Glass */
  --glass-border: rgba(148, 163, 184, 0.08);
  --glass-blur: 20px;

  /* Radius & spacing */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;

  /* Shadows */
  --shadow-card: 0 4px 32px rgba(0, 0, 0, 0.3);
  --shadow-glow-blue: 0 0 20px rgba(59, 130, 246, 0.15);
  --shadow-glow-emerald: 0 0 20px rgba(16, 185, 129, 0.15);
  --shadow-glow-rose: 0 0 20px rgba(244, 63, 94, 0.15);

  /* Transitions */
  --transition-fast: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-smooth: 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  --transition-spring: 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* ---------- Reset & Base ---------- */
*, *::before, *::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  background: var(--bg-primary);
  color: var(--text-primary);
  min-height: 100vh;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

/* ---------- Animated Background ---------- */
.bg-gradient {
  position: fixed;
  inset: 0;
  z-index: 0;
  overflow: hidden;
  pointer-events: none;
}

.bg-gradient .orb {
  position: absolute;
  border-radius: 50%;
  filter: blur(100px);
  opacity: 0.12;
  animation: orbFloat 20s ease-in-out infinite;
}

.bg-gradient .orb-1 {
  width: 600px;
  height: 600px;
  background: var(--accent-blue);
  top: -200px;
  right: -100px;
  animation-delay: 0s;
}

.bg-gradient .orb-2 {
  width: 500px;
  height: 500px;
  background: var(--accent-purple);
  bottom: -150px;
  left: -100px;
  animation-delay: -7s;
}

.bg-gradient .orb-3 {
  width: 400px;
  height: 400px;
  background: var(--accent-emerald);
  top: 50%;
  left: 50%;
  animation-delay: -14s;
}

@keyframes orbFloat {
  0%, 100% { transform: translate(0, 0) scale(1); }
  33% { transform: translate(30px, -40px) scale(1.05); }
  66% { transform: translate(-20px, 30px) scale(0.95); }
}

/* ---------- Grid noise overlay ---------- */
.bg-gradient::after {
  content: '';
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(148, 163, 184, 0.03) 1px, transparent 1px);
  background-size: 40px 40px;
}

/* ---------- Layout ---------- */
.app {
  position: relative;
  z-index: 1;
  max-width: 1200px;
  margin: 0 auto;
  padding: 40px 24px 80px;
}

/* ---------- Header ---------- */
.header {
  text-align: center;
  margin-bottom: 48px;
}

.header__badge {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: var(--bg-card);
  border: 1px solid var(--glass-border);
  border-radius: 999px;
  padding: 6px 16px;
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-secondary);
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-bottom: 20px;
  backdrop-filter: blur(var(--glass-blur));
}

.header__status-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--accent-emerald);
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgba(16, 185, 129, 0.5); }
  50% { opacity: 0.7; box-shadow: 0 0 0 6px rgba(16, 185, 129, 0); }
}

.header__title {
  font-size: 3rem;
  font-weight: 800;
  letter-spacing: -0.035em;
  line-height: 1.1;
  margin-bottom: 12px;
  background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-blue) 50%, var(--accent-purple) 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.header__subtitle {
  font-size: 1.05rem;
  color: var(--text-secondary);
  font-weight: 400;
  max-width: 520px;
  margin: 0 auto;
  line-height: 1.6;
}

/* ---------- Stats Row ---------- */
.stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px;
  margin-bottom: 40px;
}

.stat-card {
  background: var(--bg-card);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  padding: 24px;
  backdrop-filter: blur(var(--glass-blur));
  text-align: center;
  transition: transform var(--transition-fast), border-color var(--transition-fast);
}

.stat-card:hover {
  transform: translateY(-2px);
  border-color: rgba(148, 163, 184, 0.15);
}

.stat-card__icon {
  font-size: 1.5rem;
  margin-bottom: 8px;
}

.stat-card__value {
  font-size: 2rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--text-primary);
}

.stat-card__label {
  font-size: 0.8rem;
  color: var(--text-muted);
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-top: 4px;
}

/* ---------- Main Grid ---------- */
.main-grid {
  display: grid;
  grid-template-columns: 1fr 380px;
  gap: 24px;
  align-items: start;
}

/* ---------- Glass Card ---------- */
.card {
  background: var(--bg-card);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-lg);
  backdrop-filter: blur(var(--glass-blur));
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.card__header {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 20px 24px;
  border-bottom: 1px solid var(--glass-border);
}

.card__header-icon {
  font-size: 1.2rem;
}

.card__header-title {
  font-size: 0.95rem;
  font-weight: 600;
  color: var(--text-primary);
}

.card__body {
  padding: 24px;
}

/* ---------- Buttons ---------- */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 12px 24px;
  border: none;
  border-radius: var(--radius-sm);
  font-family: 'Inter', sans-serif;
  font-size: 0.875rem;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
  outline: none;
  position: relative;
  overflow: hidden;
  text-decoration: none;
}

.btn--primary {
  background: linear-gradient(135deg, var(--accent-blue), #6366f1);
  color: white;
  box-shadow: 0 2px 12px rgba(59, 130, 246, 0.3);
}

.btn--primary:hover {
  transform: translateY(-1px);
  box-shadow: 0 4px 20px rgba(59, 130, 246, 0.4);
}

.btn--primary:active {
  transform: translateY(0);
}

.btn--ghost {
  background: transparent;
  color: var(--text-secondary);
  border: 1px solid var(--glass-border);
}

.btn--ghost:hover {
  background: rgba(148, 163, 184, 0.05);
  color: var(--text-primary);
}

.btn--small {
  padding: 8px 16px;
  font-size: 0.8rem;
}

.btn--loading {
  pointer-events: none;
  opacity: 0.8;
}

.btn--loading .btn__text {
  visibility: hidden;
}

.btn--loading::after {
  content: '';
  position: absolute;
  width: 18px;
  height: 18px;
  border: 2px solid rgba(255, 255, 255, 0.3);
  border-top-color: white;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---------- Inbox Controls ---------- */
.inbox-controls {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-left: auto;
}

.inbox-label {
  font-size: 0.8rem;
  color: var(--text-muted);
  font-weight: 500;
}

.inbox-select {
  background: var(--bg-input);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: 6px 12px;
  color: var(--text-primary);
  font-family: 'Inter', sans-serif;
  font-size: 0.8rem;
  outline: none;
  cursor: pointer;
  appearance: auto;
}

.inbox-select:focus {
  border-color: var(--accent-blue);
}

/* ---------- Inbox Empty State ---------- */
.inbox-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 56px 24px;
  color: var(--text-muted);
}

.inbox-empty__icon {
  font-size: 3.5rem;
  margin-bottom: 16px;
  opacity: 0.5;
}

.inbox-empty__text {
  font-size: 0.95rem;
  line-height: 1.6;
  color: var(--text-secondary);
  margin-bottom: 8px;
}

.inbox-empty__hint {
  font-size: 0.8rem;
  color: var(--text-muted);
  font-style: italic;
}

/* ---------- Inbox Error ---------- */
.inbox-error {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 16px 20px;
  background: var(--accent-rose-glow);
  border: 1px solid rgba(244, 63, 94, 0.2);
  border-radius: var(--radius-md);
  color: var(--accent-rose);
  font-size: 0.85rem;
}

.inbox-error__icon {
  font-size: 1.2rem;
}

/* ---------- Email Cards ---------- */
@keyframes fadeSlideUp {
  from { opacity: 0; transform: translateY(16px); }
  to { opacity: 1; transform: translateY(0); }
}

.inbox-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.email-card {
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  animation: fadeSlideUp 0.4s ease both;
  border-left: 3px solid var(--glass-border);
}

.email-card--safe { border-left-color: var(--accent-emerald); }
.email-card--suspicious { border-left-color: var(--accent-amber); }
.email-card--phishing { border-left-color: var(--accent-rose); }

.email-card:hover {
  border-color: rgba(148, 163, 184, 0.15);
}

.email-card__header {
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px 18px;
  cursor: pointer;
  background: var(--bg-input);
  transition: background var(--transition-fast);
  user-select: none;
}

.email-card__header:hover {
  background: rgba(15, 23, 42, 0.95);
}

.email-card__verdict-icon {
  font-size: 1.4rem;
  flex-shrink: 0;
}

.email-card__info {
  flex: 1;
  overflow: hidden;
}

.email-card__subject {
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 4px;
}

.email-card__meta {
  display: flex;
  align-items: center;
  gap: 10px;
}

.email-card__verdict-tag {
  font-size: 0.65rem;
  font-weight: 700;
  padding: 2px 8px;
  border-radius: 999px;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.email-card__verdict-tag--safe {
  background: var(--accent-emerald-glow);
  color: var(--accent-emerald);
}

.email-card__verdict-tag--suspicious {
  background: var(--accent-amber-glow);
  color: var(--accent-amber);
}

.email-card__verdict-tag--phishing {
  background: var(--accent-rose-glow);
  color: var(--accent-rose);
}

.email-card__score {
  font-size: 0.75rem;
  color: var(--text-muted);
  font-family: 'JetBrains Mono', monospace;
}

.email-card__chevron {
  color: var(--text-muted);
  font-size: 0.8rem;
  transition: transform var(--transition-fast);
  flex-shrink: 0;
}

.email-card.open .email-card__chevron {
  transform: rotate(180deg);
}

.email-card__body {
  display: none;
  padding: 18px;
  border-top: 1px solid var(--glass-border);
  animation: fadeSlideUp 0.3s ease both;
}

.email-card.open .email-card__body {
  display: block;
}

.email-card__reasons-title {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 10px;
}

.email-card__reason {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  padding: 8px 12px;
  background: rgba(15, 23, 42, 0.5);
  border-radius: var(--radius-sm);
  margin-bottom: 6px;
  font-size: 0.8rem;
  color: var(--text-secondary);
  line-height: 1.5;
  animation: fadeSlideUp 0.3s ease both;
  border-left: 2px solid var(--accent-blue);
}

.email-card__reason:nth-child(odd) {
  border-left-color: var(--accent-purple);
}

.email-card__reason-icon {
  flex-shrink: 0;
  color: var(--text-muted);
}

.email-card__section-title {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 10px;
}

.email-card__sender {
  font-size: 0.75rem;
  color: var(--text-muted);
  max-width: 200px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.email-card__domain {
  font-size: 0.7rem;
  font-family: 'JetBrains Mono', monospace;
  color: var(--accent-blue);
  background: var(--accent-blue-glow);
  padding: 1px 6px;
  border-radius: 4px;
}

/* ---------- Engine Breakdown Chips ---------- */
.engine-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
  margin-bottom: 4px;
}

.engine-chip {
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 8px 10px;
  background: rgba(15, 23, 42, 0.5);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  font-size: 0.75rem;
  color: var(--text-muted);
  transition: all var(--transition-fast);
  flex-wrap: wrap;
}

.engine-chip--active {
  border-color: rgba(244, 63, 94, 0.2);
  background: rgba(244, 63, 94, 0.06);
  color: var(--text-secondary);
}

.engine-chip__icon {
  font-size: 0.9rem;
}

.engine-chip__name {
  font-weight: 600;
}

.engine-chip__score {
  margin-left: auto;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.7rem;
  font-weight: 700;
  color: var(--accent-rose);
}

.engine-chip__score--ok {
  color: var(--accent-emerald);
}

.engine-chip__extra {
  width: 100%;
  font-size: 0.65rem;
  color: var(--text-muted);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- Skeleton Loading ---------- */
.email-card--skeleton {
  padding: 20px;
  border-left-color: var(--glass-border);
}

.skeleton {
  border-radius: 4px;
  background: linear-gradient(90deg,
    rgba(148, 163, 184, 0.06) 0%,
    rgba(148, 163, 184, 0.12) 50%,
    rgba(148, 163, 184, 0.06) 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
}

.skeleton--line {
  height: 14px;
  margin-bottom: 10px;
}

.skeleton--w40 { width: 40%; }
.skeleton--w60 { width: 60%; }
.skeleton--w80 { width: 80%; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ---------- API Reference Section ---------- */
.api-section {
  margin-top: 40px;
}

.api-section__badge {
  margin-left: auto;
  font-size: 0.7rem;
  font-weight: 600;
  color: var(--accent-purple);
  background: rgba(168, 85, 247, 0.1);
  padding: 3px 10px;
  border-radius: 999px;
  letter-spacing: 0.03em;
}

.api-section__desc {
  font-size: 0.9rem;
  color: var(--text-secondary);
  line-height: 1.6;
  margin-bottom: 24px;
}

/* Endpoint accordion */
.api-endpoint {
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-md);
  margin-bottom: 12px;
  overflow: hidden;
  transition: border-color var(--transition-fast);
}

.api-endpoint:hover {
  border-color: rgba(148, 163, 184, 0.15);
}

.api-endpoint__header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 14px 16px;
  cursor: pointer;
  background: var(--bg-input);
  transition: background var(--transition-fast);
  user-select: none;
}

.api-endpoint__header:hover {
  background: rgba(15, 23, 42, 0.95);
}

.api-endpoint__desc {
  flex: 1;
  font-size: 0.8rem;
  color: var(--text-muted);
}

.api-endpoint__chevron {
  color: var(--text-muted);
  font-size: 0.8rem;
  transition: transform var(--transition-fast);
}

.api-endpoint.open .api-endpoint__chevron {
  transform: rotate(180deg);
}

.api-endpoint__body {
  display: none;
  padding: 20px;
  border-top: 1px solid var(--glass-border);
  animation: fadeSlideUp 0.3s ease both;
}

.api-endpoint.open .api-endpoint__body {
  display: block;
}

/* Method badges */
.api-method {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.7rem;
  font-weight: 700;
  padding: 4px 10px;
  border-radius: 4px;
  letter-spacing: 0.04em;
  flex-shrink: 0;
}

.api-method--get {
  background: var(--accent-emerald-glow);
  color: var(--accent-emerald);
  border: 1px solid rgba(16, 185, 129, 0.2);
}

.api-method--post {
  background: var(--accent-blue-glow);
  color: var(--accent-blue);
  border: 1px solid rgba(59, 130, 246, 0.2);
}

/* Path */
.api-path {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--text-primary);
}

/* Detail blocks */
.api-detail {
  margin-bottom: 16px;
}

.api-detail__label {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 8px;
}

.api-detail__text {
  font-size: 0.85rem;
  color: var(--text-secondary);
  line-height: 1.6;
}

/* Code blocks */
.api-code {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.8rem;
  background: rgba(15, 23, 42, 0.6);
  padding: 2px 8px;
  border-radius: 4px;
  color: var(--accent-blue);
}

.api-pre {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: 14px 16px;
  overflow-x: auto;
  margin: 0;
}

.api-pre code {
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.8rem;
  color: var(--text-secondary);
  line-height: 1.7;
}

.api-comment {
  color: var(--text-muted);
  font-style: italic;
}

/* Parameters */
.api-param {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 14px;
  background: rgba(15, 23, 42, 0.5);
  border-radius: var(--radius-sm);
}

.api-param__type {
  font-size: 0.75rem;
  color: var(--accent-purple);
  font-weight: 500;
  font-family: 'JetBrains Mono', monospace;
}

.api-param__default {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-left: auto;
}

/* Score thresholds */
.api-thresholds {
  display: flex;
  gap: 10px;
}

.api-threshold {
  flex: 1;
  padding: 10px 14px;
  border-radius: var(--radius-sm);
  text-align: center;
}

.api-threshold--safe {
  background: var(--accent-emerald-glow);
  border: 1px solid rgba(16, 185, 129, 0.15);
}

.api-threshold--suspicious {
  background: var(--accent-amber-glow);
  border: 1px solid rgba(245, 158, 11, 0.15);
}

.api-threshold--phishing {
  background: var(--accent-rose-glow);
  border: 1px solid rgba(244, 63, 94, 0.15);
}

.api-threshold__range {
  display: block;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.85rem;
  font-weight: 700;
  margin-bottom: 2px;
}

.api-threshold--safe .api-threshold__range { color: var(--accent-emerald); }
.api-threshold--suspicious .api-threshold__range { color: var(--accent-amber); }
.api-threshold--phishing .api-threshold__range { color: var(--accent-rose); }

.api-threshold__label {
  font-size: 0.65rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
}

/* Try it */
.api-tryit {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
  margin-top: 8px;
}

.api-tryit__hint {
  font-size: 0.75rem;
  color: var(--text-muted);
  font-style: italic;
}

.api-response {
  width: 100%;
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  padding: 14px 16px;
  margin-top: 10px;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.78rem;
  color: var(--accent-emerald);
  line-height: 1.6;
  white-space: pre-wrap;
  word-break: break-word;
  max-height: 300px;
  overflow-y: auto;
  display: none;
}

.api-response.visible {
  display: block;
  animation: fadeSlideUp 0.3s ease both;
}

.api-response.error {
  color: var(--accent-rose);
}

.btn--small {
  padding: 8px 16px;
  font-size: 0.8rem;
}

/* Detection engines grid */
.api-engines {
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid var(--glass-border);
}

.api-engines__grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}

.api-engine {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 12px 14px;
  background: var(--bg-input);
  border: 1px solid var(--glass-border);
  border-radius: var(--radius-sm);
  transition: border-color var(--transition-fast), transform var(--transition-fast);
}

.api-engine:hover {
  border-color: rgba(148, 163, 184, 0.15);
  transform: translateY(-1px);
}

.api-engine__icon {
  font-size: 1.1rem;
}

.api-engine__name {
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--text-secondary);
}

/* ---------- Footer ---------- */
.footer {
  text-align: center;
  margin-top: 56px;
  padding-top: 24px;
  border-top: 1px solid var(--glass-border);
  color: var(--text-muted);
  font-size: 0.8rem;
}

.footer a {
  color: var(--accent-blue);
  text-decoration: none;
  font-weight: 500;
}

.footer a:hover {
  text-decoration: underline;
}

/* ---------- Responsive ---------- */
@media (max-width: 900px) {
  .main-grid {
    grid-template-columns: 1fr;
  }

  .header__title {
    font-size: 2.2rem;
  }

  .stats {
    grid-template-columns: 1fr;
  }

  .api-engines__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 600px) {
  .app {
    padding: 24px 16px 60px;
  }

  .header__title {
    font-size: 1.8rem;
  }

  .card__body {
    padding: 16px;
  }

  .analyzer-textarea {
    min-height: 140px;
  }

  .api-engines__grid {
    grid-template-columns: 1fr;
  }

  .api-thresholds {
    flex-direction: column;
  }
}
===
/* ═══════════════════════════════════════════════════
   PHISHGUARD — COMMAND CENTER DESIGN SYSTEM
   Cybersecurity-grade UI · Not your average SaaS template
   ═══════════════════════════════════════════════════ */

@import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap');

/* ─── Tokens ─── */
:root {
  --bg-root: #050a14;
  --bg-sidebar: #080d1a;
  --bg-main: #0a1020;
  --bg-panel: #0d1424;
  --bg-panel-hover: #111a2e;
  --bg-input: #0b1222;
  --bg-raised: #131d32;

  --border: rgba(52, 76, 120, 0.22);
  --border-hover: rgba(52, 76, 120, 0.38);
  --border-active: rgba(34, 211, 238, 0.3);

  --text-primary: #e2e8f0;
  --text-secondary: #8b9cc0;
  --text-muted: #526280;

  --cyan: #22d3ee;
  --cyan-dim: rgba(34, 211, 238, 0.12);
  --cyan-glow: rgba(34, 211, 238, 0.06);
  --teal: #14b8a6;
  --teal-dim: rgba(20, 184, 166, 0.12);

  --red: #ef4444;
  --red-dim: rgba(239, 68, 68, 0.12);
  --red-glow: rgba(239, 68, 68, 0.06);

  --amber: #f59e0b;
  --amber-dim: rgba(245, 158, 11, 0.12);

  --green: #22c55e;
  --green-dim: rgba(34, 197, 94, 0.12);

  --blue: #3b82f6;
  --blue-dim: rgba(59, 130, 246, 0.12);

  --sidebar-w: 236px;
  --radius: 8px;
  --radius-lg: 12px;
  --ease: cubic-bezier(0.4, 0, 0.2, 1);
}

/* ─── Reset ─── */
*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  background: var(--bg-root);
  color: var(--text-primary);
  min-height: 100vh;
  display: flex;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* ─── Subtle scanline overlay on body ─── */
body::after {
  content: '';
  position: fixed;
  inset: 0;
  pointer-events: none;
  z-index: 9999;
  background: repeating-linear-gradient(
    0deg,
    transparent,
    transparent 2px,
    rgba(34, 211, 238, 0.008) 2px,
    rgba(34, 211, 238, 0.008) 4px
  );
}

/* ═══════════════════════════════
   SIDEBAR
   ═══════════════════════════════ */
.sidebar {
  width: var(--sidebar-w);
  min-height: 100vh;
  background: var(--bg-sidebar);
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  position: fixed;
  left: 0;
  top: 0;
  z-index: 100;
  transition: transform 0.3s var(--ease);
}

.sidebar__brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 24px 20px 28px;
  border-bottom: 1px solid var(--border);
}

.sidebar__logo {
  width: 40px;
  height: 40px;
  border-radius: 10px;
  background: linear-gradient(135deg, var(--cyan-dim), var(--teal-dim));
  border: 1px solid rgba(34, 211, 238, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--cyan);
  flex-shrink: 0;
}

.sidebar__name {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.02em;
  display: block;
}

.sidebar__version {
  font-size: 0.65rem;
  color: var(--text-muted);
  font-weight: 500;
  letter-spacing: 0.02em;
  display: block;
  margin-top: 2px;
}

.sidebar__nav {
  flex: 1;
  padding: 16px 12px;
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 10px 14px;
  border-radius: var(--radius);
  color: var(--text-secondary);
  text-decoration: none;
  font-size: 0.85rem;
  font-weight: 500;
  cursor: pointer;
  transition: all 0.2s var(--ease);
  position: relative;
}

.nav-item:hover {
  background: rgba(34, 211, 238, 0.04);
  color: var(--text-primary);
}

.nav-item.active {
  background: var(--cyan-dim);
  color: var(--cyan);
}

.nav-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 20px;
  background: var(--cyan);
  border-radius: 0 3px 3px 0;
}

.nav-item svg {
  flex-shrink: 0;
  opacity: 0.7;
}

.nav-item.active svg { opacity: 1; }

.nav-badge {
  margin-left: auto;
  font-size: 0.65rem;
  font-weight: 700;
  background: var(--cyan-dim);
  color: var(--cyan);
  padding: 2px 7px;
  border-radius: 999px;
  letter-spacing: 0.03em;
}

.sidebar__footer {
  padding: 16px 20px;
  border-top: 1px solid var(--border);
}

.sidebar__status {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 0.75rem;
  color: var(--text-muted);
}

.status-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  flex-shrink: 0;
}

.status-dot--online {
  background: var(--green);
  box-shadow: 0 0 6px rgba(34, 197, 94, 0.4);
  animation: statusPulse 2.5s ease-in-out infinite;
}

.status-dot--offline {
  background: var(--text-muted);
}

@keyframes statusPulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* ═══════════════════════════════
   MAIN AREA
   ═══════════════════════════════ */
.main {
  margin-left: var(--sidebar-w);
  flex: 1;
  min-height: 100vh;
  padding: 32px 36px 80px;
  max-width: 1200px;
}

/* ─── Views (SPA) ─── */
.view { display: none; }
.view.active { display: block; animation: viewFadeIn 0.35s var(--ease); }

@keyframes viewFadeIn {
  from { opacity: 0; transform: translateY(8px); }
  to { opacity: 1; transform: translateY(0); }
}

.view__header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 28px;
}

.view__title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.6rem;
  font-weight: 700;
  letter-spacing: -0.025em;
  color: var(--text-primary);
}

.view__subtitle {
  font-size: 0.85rem;
  color: var(--text-muted);
  margin-top: 4px;
  font-weight: 400;
}

.view__actions {
  display: flex;
  align-items: center;
  gap: 10px;
  flex-shrink: 0;
}

/* ═══════════════════════════════
   STAT CARDS
   ═══════════════════════════════ */
.stats-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin-bottom: 24px;
}

.stat-card {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 18px 20px 14px;
  transition: border-color 0.25s var(--ease);
}

.stat-card:hover {
  border-color: var(--border-hover);
}

.stat-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
}

.stat-card__label {
  font-size: 0.72rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.07em;
  color: var(--text-muted);
}

.stat-card__icon {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-card__icon--blue { background: var(--blue-dim); color: var(--blue); }
.stat-card__icon--red { background: var(--red-dim); color: var(--red); }
.stat-card__icon--amber { background: var(--amber-dim); color: var(--amber); }
.stat-card__icon--green { background: var(--green-dim); color: var(--green); }

.stat-card__value {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.75rem;
  font-weight: 700;
  letter-spacing: -0.03em;
  line-height: 1;
  margin-bottom: 10px;
}

.stat-card__bar {
  height: 3px;
  background: rgba(52, 76, 120, 0.15);
  border-radius: 2px;
  overflow: hidden;
}

.stat-card__bar-fill {
  height: 100%;
  border-radius: 2px;
  transition: width 0.8s var(--ease);
}

.stat-card__bar-fill--blue { background: var(--blue); }
.stat-card__bar-fill--red { background: var(--red); }
.stat-card__bar-fill--amber { background: var(--amber); }
.stat-card__bar-fill--green { background: var(--green); }

/* ═══════════════════════════════
   PANELS (Cards)
   ═══════════════════════════════ */
.panel {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  margin-bottom: 20px;
  overflow: hidden;
}

.panel__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 20px;
  border-bottom: 1px solid var(--border);
}

.panel__title {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.9rem;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.panel__count {
  font-size: 0.72rem;
  color: var(--text-muted);
  font-weight: 500;
}

.panel__body {
  padding: 20px;
}

/* ═══════════════════════════════
   BUTTONS
   ═══════════════════════════════ */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 7px;
  padding: 9px 18px;
  border: none;
  border-radius: var(--radius);
  font-family: 'Inter', sans-serif;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s var(--ease);
  outline: none;
  text-decoration: none;
  white-space: nowrap;
  position: relative;
}

.btn--primary {
  background: var(--cyan);
  color: #050a14;
}

.btn--primary:hover {
  background: #06b6d4;
  box-shadow: 0 0 20px rgba(34, 211, 238, 0.2);
}

.btn--primary:active { transform: scale(0.97); }

.btn--outline {
  background: transparent;
  color: var(--text-secondary);
  border: 1px solid var(--border);
}

.btn--outline:hover {
  border-color: var(--border-hover);
  color: var(--text-primary);
  background: rgba(52, 76, 120, 0.06);
}

.btn--ghost {
  background: transparent;
  color: var(--text-muted);
}

.btn--ghost:hover { color: var(--text-secondary); }

.btn--sm { padding: 6px 12px; font-size: 0.73rem; }

.btn--loading {
  pointer-events: none;
  opacity: 0.7;
}

.btn--loading::after {
  content: '';
  position: absolute;
  width: 14px;
  height: 14px;
  border: 2px solid rgba(5, 10, 20, 0.3);
  border-top-color: #050a14;
  border-radius: 50%;
  animation: spin 0.5s linear infinite;
}

.btn--loading > * { visibility: hidden; }

@keyframes spin { to { transform: rotate(360deg); } }

/* ═══════════════════════════════
   SELECT & INPUT
   ═══════════════════════════════ */
.select-label {
  font-size: 0.75rem;
  color: var(--text-muted);
  font-weight: 500;
}

.select {
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 7px 12px;
  color: var(--text-primary);
  font-family: 'Inter', sans-serif;
  font-size: 0.8rem;
  outline: none;
  cursor: pointer;
  appearance: auto;
  transition: border-color 0.2s var(--ease);
}

.select:focus { border-color: var(--cyan); }

/* ═══════════════════════════════
   EMPTY STATE
   ═══════════════════════════════ */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 48px 20px;
  gap: 12px;
  color: var(--text-muted);
}

.empty-state p {
  font-size: 0.85rem;
  line-height: 1.5;
}

.empty-state__hint {
  font-size: 0.75rem !important;
  color: var(--text-muted) !important;
  font-style: italic;
}

/* ═══════════════════════════════
   THREAT CHART (CSS-only bar chart)
   ═══════════════════════════════ */
.threat-chart__empty {
  text-align: center;
  padding: 20px;
  color: var(--text-muted);
  font-size: 0.82rem;
}

.threat-chart__bars {
  display: flex;
  align-items: flex-end;
  gap: 6px;
  height: 120px;
  padding: 0 4px;
}

.threat-bar {
  flex: 1;
  border-radius: 4px 4px 0 0;
  min-height: 4px;
  transition: height 0.6s var(--ease);
  position: relative;
  cursor: default;
}

.threat-bar--safe { background: var(--green); }
.threat-bar--suspicious { background: var(--amber); }
.threat-bar--phishing { background: var(--red); }

.threat-chart__legend {
  display: flex;
  gap: 20px;
  margin-top: 14px;
  padding-top: 14px;
  border-top: 1px solid var(--border);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 6px;
  font-size: 0.73rem;
  color: var(--text-secondary);
}

.legend-dot {
  width: 8px;
  height: 8px;
  border-radius: 2px;
  flex-shrink: 0;
}

.legend-dot--safe { background: var(--green); }
.legend-dot--suspicious { background: var(--amber); }
.legend-dot--phishing { background: var(--red); }

/* ═══════════════════════════════
   EMAIL LIST / CARDS
   ═══════════════════════════════ */
.email-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

@keyframes cardSlideIn {
  from { opacity: 0; transform: translateX(-8px); }
  to { opacity: 1; transform: translateX(0); }
}

.email-card {
  border: 1px solid var(--border);
  border-radius: var(--radius);
  overflow: hidden;
  transition: border-color 0.2s var(--ease);
  animation: cardSlideIn 0.3s var(--ease) both;
  border-left: 3px solid var(--border);
}

.email-card--safe { border-left-color: var(--green); }
.email-card--suspicious { border-left-color: var(--amber); }
.email-card--phishing { border-left-color: var(--red); }

.email-card:hover { border-color: var(--border-hover); }

.email-card__header {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 16px;
  cursor: pointer;
  background: var(--bg-raised);
  transition: background 0.2s var(--ease);
  user-select: none;
}

.email-card__header:hover { background: var(--bg-panel-hover); }

.email-card__verdict-badge {
  width: 32px;
  height: 32px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-size: 0.65rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.email-card--safe .email-card__verdict-badge {
  background: var(--green-dim);
  color: var(--green);
}

.email-card--suspicious .email-card__verdict-badge {
  background: var(--amber-dim);
  color: var(--amber);
}

.email-card--phishing .email-card__verdict-badge {
  background: var(--red-dim);
  color: var(--red);
}

.email-card__info { flex: 1; min-width: 0; }

.email-card__subject {
  font-size: 0.84rem;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 3px;
}

.email-card__meta {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}

.email-card__sender {
  font-size: 0.72rem;
  color: var(--text-muted);
  max-width: 220px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.email-card__tag {
  font-size: 0.6rem;
  font-weight: 700;
  padding: 2px 7px;
  border-radius: 4px;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.email-card__tag--safe { background: var(--green-dim); color: var(--green); }
.email-card__tag--suspicious { background: var(--amber-dim); color: var(--amber); }
.email-card__tag--phishing { background: var(--red-dim); color: var(--red); }

.email-card__score {
  font-size: 0.7rem;
  color: var(--text-muted);
  font-family: 'JetBrains Mono', monospace;
}

.email-card__chevron {
  color: var(--text-muted);
  font-size: 0.7rem;
  transition: transform 0.2s var(--ease);
  flex-shrink: 0;
}

.email-card.open .email-card__chevron { transform: rotate(180deg); }

.email-card__body {
  display: none;
  padding: 16px;
  border-top: 1px solid var(--border);
}

.email-card.open .email-card__body { display: block; }

.email-card__section-label {
  font-size: 0.68rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  margin-bottom: 8px;
}

/* Engine Chips */
.engine-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
  gap: 6px;
  margin-bottom: 14px;
}

.engine-chip {
  display: flex;
  align-items: center;
  gap: 5px;
  padding: 6px 8px;
  background: rgba(52, 76, 120, 0.06);
  border: 1px solid var(--border);
  border-radius: 6px;
  font-size: 0.7rem;
  color: var(--text-muted);
  transition: all 0.2s var(--ease);
}

.engine-chip--active {
  border-color: rgba(239, 68, 68, 0.2);
  background: var(--red-glow);
  color: var(--text-secondary);
}

.engine-chip__name { font-weight: 600; }

.engine-chip__score {
  margin-left: auto;
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.65rem;
  font-weight: 700;
  color: var(--red);
}

.engine-chip__score--ok { color: var(--green); }

/* Reasons list */
.reason-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  padding: 6px 10px;
  background: rgba(52, 76, 120, 0.04);
  border-left: 2px solid var(--cyan);
  border-radius: 0 6px 6px 0;
  margin-bottom: 4px;
  font-size: 0.76rem;
  color: var(--text-secondary);
  line-height: 1.45;
}

.reason-item:nth-child(even) { border-left-color: var(--teal); }

.reason-item__icon {
  flex-shrink: 0;
  color: var(--text-muted);
  font-size: 0.7rem;
  margin-top: 2px;
}

/* ═══════════════════════════════
   ANALYZE VIEW
   ═══════════════════════════════ */
.analyze-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  align-items: start;
}

.analyze-textarea {
  width: 100%;
  min-height: 320px;
  background: var(--bg-input);
  border: 1px solid var(--border);
  border-radius: var(--radius);
  padding: 14px 16px;
  color: var(--text-primary);
  font-family: 'JetBrains Mono', monospace;
  font-size: 0.78rem;
  line-height: 1.6;
  resize: vertical;
  outline: none;
  transition: border-color 0.2s var(--ease);
}

.analyze-textarea:focus { border-color: var(--cyan); }

.analyze-textarea::placeholder {
  color: var(--text-muted);
  font-family: 'JetBrains Mono', monospace;
}

.analyze-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-top: 12px;
}

/* ═══════════════════════════════
   VERDICT CARD (Analyze result)
   ═══════════════════════════════ */
.verdict-card {
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  overflow: hidden;
}

.verdict-card__header {
  padding: 20px;
  display: flex;
  align-items: center;
  gap: 16px;
}

.verdict-card--safe .verdict-card__header { background: var(--green-dim); border-bottom: 1px solid rgba(34, 197, 94, 0.15); }
.verdict-card--suspicious .verdict-card__header { background: var(--amber-dim); border-bottom: 1px solid rgba(245, 158, 11, 0.15); }
.verdict-card--phishing .verdict-card__header { background: var(--red-dim); border-bottom: 1px solid rgba(239, 68, 68, 0.15); }

.verdict-card__shield {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.verdict-card--safe .verdict-card__shield { background: rgba(34, 197, 94, 0.15); color: var(--green); }
.verdict-card--suspicious .verdict-card__shield { background: rgba(245, 158, 11, 0.15); color: var(--amber); }
.verdict-card--phishing .verdict-card__shield { background: rgba(239, 68, 68, 0.15); color: var(--red); }

.verdict-card__verdict {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.verdict-card--safe .verdict-card__verdict { color: var(--green); }
.verdict-card--suspicious .verdict-card__verdict { color: var(--amber); }
.verdict-card--phishing .verdict-card__verdict { color: var(--red); }

.verdict-card__score-label {
  font-size: 0.75rem;
  color: var(--text-muted);
  margin-top: 2px;
}

.verdict-card__score-label strong {
  font-family: 'JetBrains Mono', monospace;
  color: var(--text-secondary);
}

.verdict-card__body { padding: 16px 20px; }

/* ═══════════════════════════════
   ENGINES VIEW
   ═══════════════════════════════ */
.engines-filter {
  display: flex;
  gap: 6px;
  margin-bottom: 20px;
  flex-wrap: wrap;
}

.filter-btn {
  padding: 6px 14px;
  border: 1px solid var(--border);
  border-radius: 999px;
  background: transparent;
  color: var(--text-secondary);
  font-family: 'Inter', sans-serif;
  font-size: 0.73rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.2s var(--ease);
}

.filter-btn:hover {
  border-color: var(--border-hover);
  color: var(--text-primary);
}

.filter-btn.active {
  background: var(--cyan-dim);
  border-color: rgba(34, 211, 238, 0.25);
  color: var(--cyan);
}

.engines-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 12px;
}

.engine-card {
  background: var(--bg-panel);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  padding: 18px 20px;
  transition: all 0.25s var(--ease);
  animation: cardSlideIn 0.3s var(--ease) both;
}

.engine-card:hover {
  border-color: var(--border-hover);
  background: var(--bg-panel-hover);
}

.engine-card__top {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 10px;
}

.engine-card__icon {
  width: 34px;
  height: 34px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.engine-card__icon--header { background: var(--blue-dim); color: var(--blue); }
.engine-card__icon--domain { background: var(--cyan-dim); color: var(--cyan); }
.engine-card__icon--content { background: var(--amber-dim); color: var(--amber); }
.engine-card__icon--reputation { background: var(--green-dim); color: var(--green); }

.engine-card__name {
  font-family: 'Space Grotesk', sans-serif;
  font-size: 0.85rem;
  font-weight: 600;
  color: var(--text-primary);
  letter-spacing: -0.01em;
}

.engine-card__category {
  font-size: 0.6rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--text-muted);
  margin-top: 1px;
}

.engine-card__desc {
  font-size: 0.78rem;
  color: var(--text-secondary);
  line-height: 1.5;
}

/* ═══════════════════════════════
   SKELETON
   ═══════════════════════════════ */
.skeleton-card {
  padding: 16px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: var(--bg-panel);
}

.skeleton-line {
  height: 12px;
  border-radius: 4px;
  background: linear-gradient(90deg,
    rgba(52, 76, 120, 0.08) 0%,
    rgba(52, 76, 120, 0.16) 50%,
    rgba(52, 76, 120, 0.08) 100%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  margin-bottom: 8px;
}

.skeleton-line--w40 { width: 40%; }
.skeleton-line--w60 { width: 60%; }
.skeleton-line--w80 { width: 80%; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ═══════════════════════════════
   ERROR
   ═══════════════════════════════ */
.error-banner {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 12px 16px;
  background: var(--red-glow);
  border: 1px solid rgba(239, 68, 68, 0.15);
  border-radius: var(--radius);
  color: var(--red);
  font-size: 0.82rem;
}

/* ═══════════════════════════════
   MOBILE TOGGLE
   ═══════════════════════════════ */
.mobile-toggle {
  display: none;
  position: fixed;
  top: 16px;
  left: 16px;
  z-index: 200;
  width: 40px;
  height: 40px;
  border-radius: var(--radius);
  background: var(--bg-panel);
  border: 1px solid var(--border);
  color: var(--text-secondary);
  cursor: pointer;
  align-items: center;
  justify-content: center;
}

/* ═══════════════════════════════
   RESPONSIVE
   ═══════════════════════════════ */
@media (max-width: 1024px) {
  .stats-row { grid-template-columns: repeat(2, 1fr); }
  .analyze-grid { grid-template-columns: 1fr; }
}

@media (max-width: 768px) {
  .mobile-toggle { display: flex; }

  .sidebar {
    transform: translateX(-100%);
  }

  .sidebar.open { transform: translateX(0); }

  .main {
    margin-left: 0;
    padding: 72px 16px 60px;
  }

  .stats-row { grid-template-columns: 1fr 1fr; }
  .engines-grid { grid-template-columns: 1fr; }

  .view__header { flex-direction: column; }
  .view__actions { width: 100%; flex-wrap: wrap; }

  .analyze-grid { grid-template-columns: 1fr; }
}

@media (max-width: 480px) {
  .stats-row { grid-template-columns: 1fr; }
}

```

- Space Grotesk headings (geometric, techy)
- Deep navy palette (#050a14) with cyan accents (#22d3ee)
- Subtle CRT scanline overlay
- SVG icons instead of emoji
- Proper sidebar layout with active indicators
- Responsive down to mobile

### [script.js](file:///Users/david/fish/static/script.js) — SPA Controller

```diff:script.js
// ============================================
// PHISHING DETECTOR — GMAIL DASHBOARD JS
// ============================================

const API_BASE = '';

// ---------- State ----------
let stats = { scanned: 0, threats: 0, safe: 0 };
try {
  const saved = JSON.parse(sessionStorage.getItem('phish_stats'));
  if (saved) stats = saved;
} catch(e) {}

// ---------- DOM refs ----------
const scanBtn = document.getElementById('scan-btn');
const emailCountSelect = document.getElementById('email-count');
const inboxList = document.getElementById('inbox-list');
const inboxEmpty = document.getElementById('inbox-empty');
const statScanned = document.getElementById('stat-scanned');
const statThreats = document.getElementById('stat-threats');
const statSafe = document.getElementById('stat-safe');

// ---------- Init ----------
function init() {
  renderStats();
  scanBtn.addEventListener('click', handleScan);
  checkStatus();
}

function checkStatus() {
  fetch(`${API_BASE}/api/health`)
    .then(r => r.json())
    .then(data => {
      const dot = document.querySelector('.header__status-dot');
      if (dot && data.status === 'online') {
        dot.style.background = 'var(--accent-emerald)';
      }
    })
    .catch(() => {});
}

// ---------- Stats ----------
function renderStats() {
  animateCounter(statScanned, stats.scanned);
  animateCounter(statThreats, stats.threats);
  animateCounter(statSafe, stats.safe);
}

function animateCounter(el, target) {
  const current = parseInt(el.textContent) || 0;
  if (current === target) { el.textContent = target; return; }
  const duration = 600;
  const start = performance.now();
  function step(time) {
    const progress = Math.min((time - start) / duration, 1);
    const eased = 1 - Math.pow(1 - progress, 3);
    el.textContent = Math.round(current + (target - current) * eased);
    if (progress < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function updateStats(results) {
  results.forEach(r => {
    const verdict = r.analysis?.verdict;
    stats.scanned++;
    if (verdict === 'PHISHING' || verdict === 'SUSPICIOUS') stats.threats++;
    if (verdict === 'SAFE') stats.safe++;
  });
  sessionStorage.setItem('phish_stats', JSON.stringify(stats));
  renderStats();
}

// ---------- Gmail Scan ----------
async function handleScan() {
  const count = emailCountSelect.value;

  scanBtn.classList.add('btn--loading');
  inboxEmpty.style.display = 'none';
  inboxList.innerHTML = '';

  // Show skeleton loading
  for (let i = 0; i < Math.min(count, 5); i++) {
    inboxList.innerHTML += `
      <div class="email-card email-card--skeleton">
        <div class="skeleton skeleton--line skeleton--w40"></div>
        <div class="skeleton skeleton--line skeleton--w80"></div>
        <div class="skeleton skeleton--line skeleton--w60"></div>
      </div>
    `;
  }

  try {
    const res = await fetch(`${API_BASE}/scan-gmail?max_results=${count}`);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);

    const data = await res.json();

    // Handle auth failure / no emails
    if (data.message) {
      inboxList.innerHTML = '';
      inboxEmpty.style.display = 'flex';
      inboxEmpty.querySelector('.inbox-empty__text').innerHTML =
        `<strong>${escapeHtml(data.message)}</strong>`;
      inboxEmpty.querySelector('.inbox-empty__hint').textContent =
        'Check the terminal for OAuth prompts.';
      return;
    }

    // Render results
    inboxList.innerHTML = '';
    updateStats(data);
    data.forEach((email, i) => renderEmailCard(email, i));

  } catch (err) {
    inboxList.innerHTML = `
      <div class="inbox-error">
        <span class="inbox-error__icon">❌</span>
        <span>${escapeHtml(err.message)}</span>
      </div>
    `;
  } finally {
    scanBtn.classList.remove('btn--loading');
  }
}

// ---------- Render Email Card ----------
const ENGINE_LABELS = {
  keywords: { icon: '🔑', name: 'Keywords' },
  urls: { icon: '🔗', name: 'URLs' },
  sender: { icon: '👤', name: 'Sender' },
  reply_to: { icon: '↩️', name: 'Reply-To' },
  whois: { icon: '🌐', name: 'WHOIS' },
  levenshtein: { icon: '📐', name: 'Typosquat' },
  entropy: { icon: '📊', name: 'Entropy' },
  safe_browsing: { icon: '🛡️', name: 'Safe Browse' },
  header_forensics: { icon: '✉️', name: 'SPF/DKIM' },
};

function renderEmailCard(email, index) {
  const a = email.analysis;
  const verdict = a.verdict.toLowerCase();
  const icon = a.verdict === 'SAFE' ? '🛡️' : a.verdict === 'SUSPICIOUS' ? '⚡' : '🚨';
  const cardId = `email-card-${index}`;
  const sender = email.sender || '';
  const domain = a.sender_domain || '';

  const card = document.createElement('div');
  card.className = `email-card email-card--${verdict}`;
  card.id = cardId;
  card.style.animationDelay = `${index * 0.06}s`;

  // Build engine breakdown
  let enginesHtml = '';
  if (a.engines) {
    enginesHtml = `<div class="engine-grid">`;
    for (const [key, info] of Object.entries(a.engines)) {
      const label = ENGINE_LABELS[key] || { icon: '⚙️', name: key };
      const score = info.score || 0;
      const active = score > 0;
      const cls = active ? 'engine-chip--active' : '';
      let extra = '';
      if (key === 'whois' && info.domains_checked && info.domains_checked.length > 0) {
        extra = ` · ${info.domains_checked.join(', ')}`;
      }
      if (key === 'urls' && info.count > 0) {
        extra = ` · ${info.count} found`;
      }
      if (key === 'keywords' && info.hits > 0) {
        extra = ` · ${info.hits} hits`;
      }
      enginesHtml += `
        <div class="engine-chip ${cls}" title="${label.name}: score ${score}">
          <span class="engine-chip__icon">${label.icon}</span>
          <span class="engine-chip__name">${label.name}</span>
          ${active ? `<span class="engine-chip__score">+${score}</span>` : '<span class="engine-chip__score engine-chip__score--ok">✓</span>'}
          ${extra ? `<span class="engine-chip__extra">${escapeHtml(extra)}</span>` : ''}
        </div>
      `;
    }
    enginesHtml += `</div>`;
  }

  card.innerHTML = `
    <div class="email-card__header" onclick="toggleEmailCard('${cardId}')">
      <span class="email-card__verdict-icon">${icon}</span>
      <div class="email-card__info">
        <div class="email-card__subject">${escapeHtml(email.subject)}</div>
        <div class="email-card__meta">
          <span class="email-card__sender">${escapeHtml(sender)}</span>
          ${domain ? `<span class="email-card__domain">${escapeHtml(domain)}</span>` : ''}
          <span class="email-card__verdict-tag email-card__verdict-tag--${verdict}">${a.verdict}</span>
          <span class="email-card__score">Score: ${a.score}</span>
        </div>
      </div>
      <span class="email-card__chevron">▾</span>
    </div>
    <div class="email-card__body">
      <div class="email-card__section-title">Engine Breakdown</div>
      ${enginesHtml}
      ${a.reasons && a.reasons.length > 0 ? `
        <div class="email-card__section-title" style="margin-top: 16px;">Detection Details (${a.reasons.length})</div>
        ${a.reasons.map((reason, i) => `
          <div class="email-card__reason" style="animation-delay: ${i * 0.05}s">
            <span class="email-card__reason-icon">›</span>
            <span>${escapeHtml(reason)}</span>
          </div>
        `).join('')}
      ` : `
        <div class="email-card__section-title" style="margin-top: 16px;">Detection Details</div>
        <div class="email-card__reason">
          <span class="email-card__reason-icon">✓</span>
          <span>No suspicious indicators detected.</span>
        </div>
      `}
    </div>
  `;

  inboxList.appendChild(card);
}

function toggleEmailCard(id) {
  const card = document.getElementById(id);
  if (card) card.classList.toggle('open');
}

// ---------- API Reference ----------
function toggleEndpoint(id) {
  const el = document.getElementById(id);
  if (el) el.classList.toggle('open');
}

async function tryEndpoint(method, path, endpointId) {
  const responseEl = document.getElementById(`response-${endpointId}`);
  if (!responseEl) return;

  responseEl.className = 'api-response visible';
  responseEl.textContent = 'Loading...';

  try {
    const res = await fetch(`${API_BASE}${path}`, { method });
    const data = await res.json();
    responseEl.textContent = JSON.stringify(data, null, 2);
    responseEl.classList.remove('error');
  } catch (err) {
    responseEl.textContent = `Error: ${err.message}`;
    responseEl.classList.add('error');
  }
}

// ---------- Utilities ----------
function escapeHtml(str) {
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

// ---------- Start ----------
document.addEventListener('DOMContentLoaded', init);
===
// ═══════════════════════════════════════════════════
// PHISHGUARD — Command Center SPA Controller
// ═══════════════════════════════════════════════════

const API = '';

// ─── State ───
let stats = { scanned: 0, threats: 0, suspicious: 0, safe: 0 };
let scanHistory = []; // Array of { verdict, score, subject, sender }
try {
  const s = JSON.parse(sessionStorage.getItem('pg_stats'));
  if (s) stats = s;
  const h = JSON.parse(sessionStorage.getItem('pg_history'));
  if (h) scanHistory = h;
} catch (e) {}

// ─── Boot ───
document.addEventListener('DOMContentLoaded', () => {
  initNav();
  initDashboard();
  initAnalyze();
  initGmail();
  initEngines();
  checkHealth();
});

// ═══════════════════════════════
// NAVIGATION
// ═══════════════════════════════
function initNav() {
  const navItems = document.querySelectorAll('.nav-item');
  navItems.forEach(item => {
    item.addEventListener('click', () => {
      const viewId = item.dataset.view;
      switchView(viewId);
    });
  });

  // Mobile toggle
  const toggle = document.getElementById('mobile-toggle');
  const sidebar = document.getElementById('sidebar');
  if (toggle && sidebar) {
    toggle.addEventListener('click', () => {
      sidebar.classList.toggle('open');
    });
  }

  // Check URL hash
  const hash = location.hash.replace('#', '');
  if (hash && document.getElementById(`view-${hash}`)) {
    switchView(hash);
  }
}

function switchView(viewId) {
  // Views
  document.querySelectorAll('.view').forEach(v => v.classList.remove('active'));
  const target = document.getElementById(`view-${viewId}`);
  if (target) target.classList.add('active');

  // Nav items
  document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
  const navItem = document.querySelector(`.nav-item[data-view="${viewId}"]`);
  if (navItem) navItem.classList.add('active');

  // Close mobile sidebar
  document.getElementById('sidebar')?.classList.remove('open');

  // Update hash
  location.hash = viewId;
}

// ═══════════════════════════════
// HEALTH CHECK
// ═══════════════════════════════
function checkHealth() {
  fetch(`${API}/api/health`)
    .then(r => r.json())
    .then(data => {
      const statusEl = document.getElementById('system-status');
      if (statusEl && data.status === 'online') {
        statusEl.innerHTML = `
          <span class="status-dot status-dot--online"></span>
          <span class="status-text">Online · ${data.engines || 20} engines</span>
        `;
      }
    })
    .catch(() => {});
}

// ═══════════════════════════════
// DASHBOARD
// ═══════════════════════════════
function initDashboard() {
  renderStats();
  renderThreatChart();
  renderRecentResults();
}

function renderStats() {
  animateCounter('stat-scanned', stats.scanned);
  animateCounter('stat-threats', stats.threats);
  animateCounter('stat-suspicious', stats.suspicious);
  animateCounter('stat-safe', stats.safe);

  // Progress bars
  const total = Math.max(stats.scanned, 1);
  setBarWidth('stat-card-scanned', 100);
  setBarWidth('stat-card-threats', (stats.threats / total) * 100);
  setBarWidth('stat-card-suspicious', (stats.suspicious / total) * 100);
  setBarWidth('stat-card-safe', (stats.safe / total) * 100);
}

function setBarWidth(cardId, pct) {
  const card = document.getElementById(cardId);
  if (!card) return;
  const fill = card.querySelector('.stat-card__bar-fill');
  if (fill) fill.style.width = `${Math.min(pct, 100)}%`;
}

function animateCounter(elementId, target) {
  const el = document.getElementById(elementId);
  if (!el) return;

  const current = parseInt(el.textContent) || 0;
  if (current === target) { el.textContent = target; return; }

  const duration = 500;
  const start = performance.now();

  function step(time) {
    const progress = Math.min((time - start) / duration, 1);
    const eased = 1 - Math.pow(1 - progress, 3);
    el.textContent = Math.round(current + (target - current) * eased);
    if (progress < 1) requestAnimationFrame(step);
  }
  requestAnimationFrame(step);
}

function updateStats(results) {
  results.forEach(r => {
    const v = r.analysis?.verdict;
    stats.scanned++;
    if (v === 'PHISHING') stats.threats++;
    else if (v === 'SUSPICIOUS') stats.suspicious++;
    else stats.safe++;

    scanHistory.push({
      verdict: v,
      score: r.analysis?.score || 0,
      subject: r.subject,
      sender: r.sender,
    });
  });
  saveState();
  renderStats();
  renderThreatChart();
  renderRecentResults();
}

function resetStats() {
  stats = { scanned: 0, threats: 0, suspicious: 0, safe: 0 };
  scanHistory = [];
  saveState();
  renderStats();
  renderThreatChart();
  renderRecentResults();
}

function saveState() {
  sessionStorage.setItem('pg_stats', JSON.stringify(stats));
  sessionStorage.setItem('pg_history', JSON.stringify(scanHistory.slice(-100)));
}

// ─── Threat Chart ───
function renderThreatChart() {
  const container = document.getElementById('threat-chart');
  if (!container) return;

  if (scanHistory.length === 0) {
    container.innerHTML = '<div class="threat-chart__empty">No scan data yet. Run Gmail Scanner or Analyze an email to see results.</div>';
    return;
  }

  // Group last 20 results into bars
  const recent = scanHistory.slice(-30);
  let barsHtml = '<div class="threat-chart__bars">';
  recent.forEach((item, i) => {
    const cls = item.verdict === 'SAFE' ? 'safe' : item.verdict === 'SUSPICIOUS' ? 'suspicious' : 'phishing';
    const height = Math.max(8, Math.min(item.score * 8, 100));
    barsHtml += `<div class="threat-bar threat-bar--${cls}" style="height:${height}%;animation-delay:${i * 0.03}s" title="${esc(item.subject || 'Email')} — ${item.verdict} (Score: ${item.score})"></div>`;
  });
  barsHtml += '</div>';

  barsHtml += `
    <div class="threat-chart__legend">
      <div class="legend-item"><span class="legend-dot legend-dot--safe"></span> Safe (${stats.safe})</div>
      <div class="legend-item"><span class="legend-dot legend-dot--suspicious"></span> Suspicious (${stats.suspicious})</div>
      <div class="legend-item"><span class="legend-dot legend-dot--phishing"></span> Phishing (${stats.threats})</div>
    </div>
  `;

  container.innerHTML = barsHtml;
}

// ─── Recent Results ───
function renderRecentResults() {
  const container = document.getElementById('recent-results');
  const countEl = document.getElementById('recent-count');
  if (!container) return;

  if (scanHistory.length === 0) {
    container.innerHTML = `
      <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
        </svg>
        <p>Scan emails to see results here</p>
      </div>
    `;
    if (countEl) countEl.textContent = '0 emails';
    return;
  }

  const recent = scanHistory.slice(-10).reverse();
  if (countEl) countEl.textContent = `${scanHistory.length} total · showing last ${recent.length}`;

  let html = '<div class="email-list">';
  recent.forEach((item, i) => {
    const cls = item.verdict === 'SAFE' ? 'safe' : item.verdict === 'SUSPICIOUS' ? 'suspicious' : 'phishing';
    html += `
      <div class="email-card email-card--${cls}" style="animation-delay:${i * 0.04}s">
        <div class="email-card__header" style="cursor:default">
          <div class="email-card__verdict-badge">
            ${item.verdict === 'SAFE' ? '✓' : item.verdict === 'SUSPICIOUS' ? '!' : '✕'}
          </div>
          <div class="email-card__info">
            <div class="email-card__subject">${esc(item.subject || 'No Subject')}</div>
            <div class="email-card__meta">
              <span class="email-card__sender">${esc(item.sender || 'Unknown')}</span>
              <span class="email-card__tag email-card__tag--${cls}">${item.verdict}</span>
              <span class="email-card__score">Score: ${item.score}</span>
            </div>
          </div>
        </div>
      </div>
    `;
  });
  html += '</div>';
  container.innerHTML = html;
}

// ═══════════════════════════════
// ANALYZE VIEW
// ═══════════════════════════════
const SAMPLE_EMAIL = `From: security-alert@paypa1-verify.com
Reply-To: phisher@gmail.com
Return-Path: bounce@random-domain.xyz
Subject: URGENT: Your PayPal account has been compromised!!!
Authentication-Results: mx.google.com; spf=fail; dkim=fail; dmarc=fail
X-Spam-Status: Yes
MIME-Version: 1.0
Content-Type: multipart/mixed; boundary="boundary123"

--boundary123
Content-Type: text/plain; charset="UTF-8"

Dear Valued Customer,

We have detected unauthorized access to your PayPal account. Your account will be SUSPENDED within 24 hours unless you verify your identity immediately.

Click here to verify: http://paypa1-secure.xyz/login?redirect=true&user=victim

You must act now to prevent permanent account closure. Enter your details including credit card number and social security number.

This is your FINAL WARNING. Do not ignore this message.

Best regards,
PayPal Security Team

--boundary123
Content-Type: application/octet-stream; name="verify_account.exe"
Content-Disposition: attachment; filename="verify_account.exe"

[binary content]
--boundary123--`;

function initAnalyze() {
  const analyzeBtn = document.getElementById('analyze-btn');
  const clearBtn = document.getElementById('clear-input-btn');
  const sampleBtn = document.getElementById('load-sample-btn');
  const input = document.getElementById('email-input');

  analyzeBtn?.addEventListener('click', handleAnalyze);
  clearBtn?.addEventListener('click', () => {
    if (input) input.value = '';
    document.getElementById('analyze-result').innerHTML = `
      <div class="empty-state">
        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" opacity="0.3">
          <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        </svg>
        <p>Paste an email and click Analyze to see results</p>
      </div>
    `;
  });
  sampleBtn?.addEventListener('click', () => {
    if (input) input.value = SAMPLE_EMAIL;
  });
}

async function handleAnalyze() {
  const input = document.getElementById('email-input');
  const resultEl = document.getElementById('analyze-result');
  const btn = document.getElementById('analyze-btn');
  if (!input || !resultEl) return;

  const raw = input.value.trim();
  if (!raw) {
    resultEl.innerHTML = '<div class="error-banner">Please paste an email to analyze.</div>';
    return;
  }

  btn?.classList.add('btn--loading');
  resultEl.innerHTML = `
    <div class="skeleton-card">
      <div class="skeleton-line skeleton-line--w40"></div>
      <div class="skeleton-line skeleton-line--w80"></div>
      <div class="skeleton-line skeleton-line--w60"></div>
      <div class="skeleton-line skeleton-line--w80"></div>
    </div>
  `;

  try {
    const res = await fetch(`${API}/analyze`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ raw_email: raw }),
    });

    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();

    // Add to stats
    stats.scanned++;
    if (data.verdict === 'PHISHING') stats.threats++;
    else if (data.verdict === 'SUSPICIOUS') stats.suspicious++;
    else stats.safe++;

    scanHistory.push({
      verdict: data.verdict,
      score: data.score,
      subject: raw.match(/Subject:\s*(.+)/i)?.[1] || 'Manual Analysis',
      sender: raw.match(/From:\s*(.+)/i)?.[1] || 'Unknown',
    });
    saveState();
    renderStats();
    renderThreatChart();
    renderRecentResults();

    resultEl.innerHTML = renderVerdictCard(data);
  } catch (err) {
    resultEl.innerHTML = `<div class="error-banner">Error: ${esc(err.message)}</div>`;
  } finally {
    btn?.classList.remove('btn--loading');
  }
}

function renderVerdictCard(data) {
  const v = data.verdict.toLowerCase();
  const icon = v === 'safe'
    ? '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>'
    : v === 'suspicious'
    ? '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
    : '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>';

  let enginesHtml = '';
  if (data.engines) {
    enginesHtml = '<div class="engine-grid">';
    for (const [key, info] of Object.entries(data.engines)) {
      const label = ENGINE_LABELS[key] || { name: key };
      const score = info.score || 0;
      const active = score > 0;
      enginesHtml += `
        <div class="engine-chip ${active ? 'engine-chip--active' : ''}" title="${label.name}: score ${score}">
          <span class="engine-chip__name">${label.name}</span>
          ${active
            ? `<span class="engine-chip__score">+${score}</span>`
            : '<span class="engine-chip__score engine-chip__score--ok">✓</span>'}
        </div>
      `;
    }
    enginesHtml += '</div>';
  }

  let reasonsHtml = '';
  if (data.reasons && data.reasons.length > 0) {
    reasonsHtml = data.reasons.map(r =>
      `<div class="reason-item"><span class="reason-item__icon">›</span><span>${esc(String(r))}</span></div>`
    ).join('');
  } else {
    reasonsHtml = '<div class="reason-item"><span class="reason-item__icon">✓</span><span>No suspicious indicators detected.</span></div>';
  }

  return `
    <div class="verdict-card verdict-card--${v}">
      <div class="verdict-card__header">
        <div class="verdict-card__shield">${icon}</div>
        <div>
          <div class="verdict-card__verdict">${data.verdict}</div>
          <div class="verdict-card__score-label">Risk Score: <strong>${data.score}</strong></div>
        </div>
      </div>
      <div class="verdict-card__body">
        <div class="email-card__section-label" style="margin-bottom:10px;">Engine Breakdown (${Object.keys(data.engines || {}).length} engines)</div>
        ${enginesHtml}
        <div class="email-card__section-label" style="margin:14px 0 8px;">Detection Details (${data.reasons?.length || 0})</div>
        ${reasonsHtml}
      </div>
    </div>
  `;
}

// ═══════════════════════════════
// GMAIL SCANNER
// ═══════════════════════════════
function initGmail() {
  document.getElementById('scan-btn')?.addEventListener('click', handleGmailScan);
}

async function handleGmailScan() {
  const btn = document.getElementById('scan-btn');
  const count = document.getElementById('email-count')?.value || 10;
  const listEl = document.getElementById('gmail-list');
  const emptyEl = document.getElementById('gmail-empty');

  btn?.classList.add('btn--loading');
  if (emptyEl) emptyEl.style.display = 'none';
  if (listEl) {
    listEl.innerHTML = '';
    for (let i = 0; i < Math.min(count, 5); i++) {
      listEl.innerHTML += `
        <div class="skeleton-card" style="animation-delay:${i * 0.05}s">
          <div class="skeleton-line skeleton-line--w40"></div>
          <div class="skeleton-line skeleton-line--w80"></div>
          <div class="skeleton-line skeleton-line--w60"></div>
        </div>
      `;
    }
  }

  try {
    const res = await fetch(`${API}/scan-gmail?max_results=${count}`);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);
    const data = await res.json();

    if (data.message) {
      if (listEl) listEl.innerHTML = '';
      if (emptyEl) {
        emptyEl.style.display = 'flex';
        emptyEl.querySelector('p').innerHTML = `<strong>${esc(data.message)}</strong>`;
      }
      return;
    }

    if (listEl) listEl.innerHTML = '';
    updateStats(data);
    data.forEach((email, i) => renderEmailCard(email, i, listEl));

  } catch (err) {
    if (listEl) listEl.innerHTML = `<div class="error-banner">Error: ${esc(err.message)}</div>`;
  } finally {
    btn?.classList.remove('btn--loading');
  }
}

// ═══════════════════════════════
// EMAIL CARD RENDERER
// ═══════════════════════════════
const ENGINE_LABELS = {
  keywords: { name: 'Keywords' },
  urls: { name: 'URLs' },
  sender: { name: 'Sender' },
  reply_to: { name: 'Reply-To' },
  whois: { name: 'WHOIS' },
  levenshtein: { name: 'Typosquat' },
  entropy: { name: 'Entropy' },
  safe_browsing: { name: 'Safe Browse' },
  header_forensics: { name: 'SPF/DKIM' },
  homoglyph: { name: 'Homoglyph' },
  punycode: { name: 'Punycode' },
  subdomain_abuse: { name: 'Subdomain' },
  domain_mismatch: { name: 'Link Mismatch' },
  return_path: { name: 'Return-Path' },
  attachments: { name: 'Attachments' },
  html_obfuscation: { name: 'HTML Tricks' },
  form_action: { name: 'Form Action' },
  image_only: { name: 'Image Email' },
  phishtank: { name: 'PhishTank' },
  ip_reputation: { name: 'IP Rep' },
};

function renderEmailCard(email, index, container) {
  const a = email.analysis;
  const v = a.verdict.toLowerCase();
  const cardId = `email-${index}`;

  const card = document.createElement('div');
  card.className = `email-card email-card--${v}`;
  card.id = cardId;
  card.style.animationDelay = `${index * 0.04}s`;

  // Engine chips
  let enginesHtml = '<div class="engine-grid">';
  if (a.engines) {
    for (const [key, info] of Object.entries(a.engines)) {
      const label = ENGINE_LABELS[key] || { name: key };
      const score = info.score || 0;
      const active = score > 0;
      enginesHtml += `
        <div class="engine-chip ${active ? 'engine-chip--active' : ''}">
          <span class="engine-chip__name">${label.name}</span>
          ${active
            ? `<span class="engine-chip__score">+${score}</span>`
            : '<span class="engine-chip__score engine-chip__score--ok">✓</span>'}
        </div>
      `;
    }
  }
  enginesHtml += '</div>';

  // Reasons
  let reasonsHtml = '';
  if (a.reasons && a.reasons.length > 0) {
    reasonsHtml = a.reasons.map(r =>
      `<div class="reason-item"><span class="reason-item__icon">›</span><span>${esc(String(r))}</span></div>`
    ).join('');
  } else {
    reasonsHtml = '<div class="reason-item"><span class="reason-item__icon">✓</span><span>No suspicious indicators detected.</span></div>';
  }

  card.innerHTML = `
    <div class="email-card__header" onclick="toggleCard('${cardId}')">
      <div class="email-card__verdict-badge">
        ${v === 'safe' ? '✓' : v === 'suspicious' ? '!' : '✕'}
      </div>
      <div class="email-card__info">
        <div class="email-card__subject">${esc(email.subject)}</div>
        <div class="email-card__meta">
          <span class="email-card__sender">${esc(email.sender || '')}</span>
          <span class="email-card__tag email-card__tag--${v}">${a.verdict}</span>
          <span class="email-card__score">Score: ${a.score}</span>
        </div>
      </div>
      <span class="email-card__chevron">▾</span>
    </div>
    <div class="email-card__body">
      <div class="email-card__section-label">Engine Breakdown</div>
      ${enginesHtml}
      <div class="email-card__section-label" style="margin-top:14px;">Detection Details (${a.reasons?.length || 0})</div>
      ${reasonsHtml}
    </div>
  `;

  container?.appendChild(card);
}

function toggleCard(id) {
  document.getElementById(id)?.classList.toggle('open');
}

// ═══════════════════════════════
// ENGINES VIEW
// ═══════════════════════════════
function initEngines() {
  loadEngines();

  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      filterEngines(btn.dataset.filter);
    });
  });
}

async function loadEngines() {
  const grid = document.getElementById('engines-grid');
  if (!grid) return;

  try {
    const res = await fetch(`${API}/api/engines`);
    if (!res.ok) throw new Error('Failed to load engines');
    const engines = await res.json();

    grid.innerHTML = '';
    engines.forEach((eng, i) => {
      const iconClass = `engine-card__icon--${eng.category}`;
      const card = document.createElement('div');
      card.className = 'engine-card';
      card.dataset.category = eng.category;
      card.style.animationDelay = `${i * 0.03}s`;

      card.innerHTML = `
        <div class="engine-card__top">
          <div class="engine-card__icon ${iconClass}">
            ${getEngineIcon(eng.icon)}
          </div>
          <div>
            <div class="engine-card__name">${esc(eng.name)}</div>
            <div class="engine-card__category">${esc(eng.category)}</div>
          </div>
        </div>
        <div class="engine-card__desc">${esc(eng.description)}</div>
      `;

      grid.appendChild(card);
    });
  } catch (err) {
    grid.innerHTML = `<div class="error-banner">Could not load engines: ${esc(err.message)}</div>`;
  }
}

function filterEngines(category) {
  const cards = document.querySelectorAll('.engine-card');
  cards.forEach(card => {
    if (category === 'all' || card.dataset.category === category) {
      card.style.display = '';
    } else {
      card.style.display = 'none';
    }
  });
}

function getEngineIcon(iconName) {
  const icons = {
    search: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>',
    link: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>',
    user: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>',
    'corner-up-left': '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 14 4 9 9 4"/><path d="M20 20v-7a4 4 0 0 0-4-4H4"/></svg>',
    calendar: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>',
    type: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="4 7 4 4 20 4 20 7"/><line x1="9" y1="20" x2="15" y2="20"/><line x1="12" y1="4" x2="12" y2="20"/></svg>',
    activity: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>',
    shield: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>',
    lock: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>',
    eye: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>',
    globe: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>',
    layers: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>',
    'alert-triangle': '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
    'corner-down-left': '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 10 4 15 9 20"/><path d="M20 4v7a4 4 0 0 1-4 4H4"/></svg>',
    paperclip: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>',
    code: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>',
    'log-in': '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/><polyline points="10 17 15 12 10 7"/><line x1="15" y1="12" x2="3" y2="12"/></svg>',
    image: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>',
    database: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>',
    server: '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/></svg>',
  };
  return icons[iconName] || icons.shield;
}

// ═══════════════════════════════
// UTILS
// ═══════════════════════════════
function esc(str) {
  if (typeof str !== 'string') str = String(str);
  const div = document.createElement('div');
  div.textContent = str;
  return div.innerHTML;
}

```

- Hash-based SPA routing
- Manual email analyzer with built-in phishing sample
- Session-persistent stats
- CSS-only threat distribution bar chart
- Engine details loaded from `/api/engines`
- Category filtering on engines view

