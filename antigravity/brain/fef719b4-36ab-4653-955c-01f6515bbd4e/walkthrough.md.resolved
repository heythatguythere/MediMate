# --- 1. WHOIS DOMAIN AGE CHECK ---
def whois_domain_age(domain):
    """Check domain registration age. New domains are suspicious."""
    score, reasons = 0, []
    try:
        w = whois.whois(domain)
        creation_date = w.creation_date
        if isinstance(creation_date, list):
            creation_date = creation_date[0]
        if creation_date:
            age_days = (datetime.now() - creation_date).days
            if age_days < 30:
                score += 5
                reasons.append(f"Domain '{domain}' is only {age_days} days old (HIGH RISK)")
            elif age_days < 90:
                score += 3
                reasons.append(f"Domain '{domain}' is only {age_days} days old (recently registered)")
            elif age_days < 180:
                score += 1
                reasons.append(f"Domain '{domain}' is {age_days} days old (relatively new)")

            # Check if registrar info is hidden/private
            registrar = w.registrar or ""
            if any(word in registrar.lower() for word in ["privacy", "proxy", "whoisguard", "domains by proxy", "contact privacy"]):
                score += 2
                reasons.append(f"Domain uses privacy protection: {registrar}")
    except Exception as e:
        logger.debug(f"WHOIS lookup failed for {domain}: {e}")
    return score, reasons


# --- 2. LEVENSHTEIN DISTANCE (Auto lookalike detection) ---
def levenshtein_domain_check(domain):
    """Auto-detect typosquatting by measuring edit distance to known brands."""
    score, reasons = 0, []
    # Strip TLD for comparison
    domain_base = domain.split('.')[0].lower()

    for brand in impersonated_brands:
        if brand == domain_base:
            continue  # exact match = legit
        distance = Levenshtein.distance(brand, domain_base)
        # Flag if domain is 1-2 characters off from a brand
        if distance == 1:
            score += 5
            reasons.append(f"Domain '{domain}' is 1 char away from '{brand}' (likely typosquatting)")
        elif distance == 2 and len(brand) >= 5:
            score += 3
            reasons.append(f"Domain '{domain}' is 2 chars away from '{brand}' (possible typosquatting)")
    return score, reasons


# --- 3. SHANNON ENTROPY (Random domain detection) ---
def calculate_entropy(text):
    """Calculate Shannon entropy of a string. High entropy = random/generated."""
    if not text:
        return 0.0
    freq = {}
    for c in text:
        freq[c] = freq.get(c, 0) + 1
    length = len(text)
    entropy = -sum((count / length) * math.log2(count / length) for count in freq.values())
    return entropy


def entropy_domain_check(domain):
    """Flag domains with high entropy (randomly generated names)."""
    score, reasons = 0, []
    domain_base = domain.split('.')[0].lower()

    if len(domain_base) < 4:
        return score, reasons

    entropy = calculate_entropy(domain_base)

    # Legitimate domains typically have entropy < 3.5
    # Random strings like "xk7qr2m" have entropy > 3.5
    if entropy > 4.0 and len(domain_base) > 8:
        score += 4
        reasons.append(f"Domain '{domain}' has very high entropy ({entropy:.2f}) - likely auto-generated")
    elif entropy > 3.5 and len(domain_base) > 6:
        score += 2
        reasons.append(f"Domain '{domain}' has high entropy ({entropy:.2f}) - possibly random")

    # Check for excessive consonant clusters (gibberish detector)
    consonant_clusters = re.findall(r'[^aeiou]{4,}', domain_base)
    if consonant_clusters:
        score += 2
        reasons.append(f"Domain has unusual consonant clusters: {consonant_clusters}")

    return score, reasons


