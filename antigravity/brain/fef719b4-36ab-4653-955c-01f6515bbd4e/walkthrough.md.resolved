SAFE_BROWSING_API_KEY = os.environ.get("GOOGLE_SAFE_BROWSING_KEY", "AIzaSyDoIUHEA2bdaS9rNfs3Krn7526QvoPdt0A")


def safe_browsing_check(urls):
    """Check URLs against Google Safe Browsing API."""
    score, reasons = 0, []
    if not SAFE_BROWSING_API_KEY or not urls:
        return score, reasons

    try:
        api_url = f"https://safebrowsing.googleapis.com/v4/threatMatches:find?key={SAFE_BROWSING_API_KEY}"
        payload = {
            "client": {"clientId": "phishing-detector", "clientVersion": "1.0"},
            "threatInfo": {
                "threatTypes": ["MALWARE", "SOCIAL_ENGINEERING", "UNWANTED_SOFTWARE",
                                "POTENTIALLY_HARMFUL_APPLICATION", "THREAT_TYPE_UNSPECIFIED"],
                "platformTypes": ["ANY_PLATFORM"],
                "threatEntryTypes": ["URL"],
                "threatEntries": [{"url": u} for u in urls[:10]]  # API limit
            }
        }
        response = requests.post(api_url, json=payload, timeout=5)
        if response.status_code == 200:
            data = response.json()
            matches = data.get("matches", [])
            for match in matches:
                threat_type = match.get("threatType", "UNKNOWN")
                threat_url = match.get("threat", {}).get("url", "")
                score += 10  # Google flagged it = very bad
                reasons.append(f"Google Safe Browsing: {threat_url} flagged as {threat_type}")
    except Exception as e:
        logger.debug(f"Safe Browsing API error: {e}")

    return score, reasons


# --- 5. EMAIL HEADER FORENSICS (SPF/DKIM/DMARC) ---
def header_forensics(msg):
    """Analyze email authentication headers for spoofing indicators."""
    score, reasons = 0, []
    if not msg:
        return score, reasons

    # Check Authentication-Results header
    auth_results = msg.get("Authentication-Results", "")
    if auth_results:
        auth_lower = auth_results.lower()

        # SPF check
        if "spf=fail" in auth_lower or "spf=softfail" in auth_lower:
            score += 4
            reasons.append("SPF authentication FAILED (sender domain didn't authorize this server)")
        elif "spf=none" in auth_lower:
            score += 2
            reasons.append("No SPF record found for sender domain")
        elif "spf=pass" in auth_lower:
            reasons.append("SPF: PASS ✓")

        # DKIM check
        if "dkim=fail" in auth_lower:
            score += 4
            reasons.append("DKIM signature FAILED (email may have been tampered with)")
        elif "dkim=none" in auth_lower:
            score += 1
            reasons.append("No DKIM signature found")
        elif "dkim=pass" in auth_lower:
            reasons.append("DKIM: PASS ✓")

        # DMARC check
        if "dmarc=fail" in auth_lower:
            score += 5
            reasons.append("DMARC authentication FAILED (HIGH RISK - likely spoofed)")
        elif "dmarc=none" in auth_lower:
            score += 1
            reasons.append("No DMARC policy found for sender domain")
        elif "dmarc=pass" in auth_lower:
            reasons.append("DMARC: PASS ✓")
    else:
        score += 1
        reasons.append("No Authentication-Results header (cannot verify sender)")

    # Check Received-SPF header (alternative location)
    received_spf = msg.get("Received-SPF", "")
    if received_spf:
        if "fail" in received_spf.lower():
            score += 3
            reasons.append(f"Received-SPF: FAIL")

    # Check X-Spam headers
    spam_status = msg.get("X-Spam-Status", "")
    if spam_status and "yes" in spam_status.lower():
        score += 3
        reasons.append(f"Marked as spam by mail server")

    spam_score_header = msg.get("X-Spam-Score", "")
    if spam_score_header:
        try:
            spam_val = float(spam_score_header)
            if spam_val > 5.0:
                score += 3
                reasons.append(f"High spam score from mail server: {spam_val}")
        except ValueError:
            pass

    # Check for suspicious Received chain (excessive hops)
    received_headers = msg.get_all("Received") or []
    if len(received_headers) > 10:
        score += 2
        reasons.append(f"Excessive mail relay hops: {len(received_headers)} (possible obfuscation)")

    return score, reasons


def extract_domain_from_url(url):
    """Extract clean domain from a URL."""
    try:
        parsed = urlparse(url)
        return parsed.netloc or parsed.path.split('/')[0]
    except Exception:
        return ""


def extract_domain_from_sender(sender):
    """Extract domain from email sender string."""
    if "@" not in sender:
        return ""
    return sender.lower().split("@")[-1].strip(">").strip()


# -------------------------
# ANALYZER & ENDPOINTS
# -------------------------
def analyze_email(subject, sender, body, msg=None):
    # --- Whitelist check: skip all engines for trusted domains ---
    sender_domain_wl = extract_domain_from_sender(sender)
    if sender_domain_wl and any(sender_domain_wl.endswith(d) for d in WHITELISTED_DOMAINS):
        return {
            "score": 0,
            "verdict": "SAFE",
            "reasons": [f"Whitelisted domain: {sender_domain_wl}"],
            "engines": {},
            "sender_domain": sender_domain_wl,
        }

    total_score = 0
    reasons = []
    engines = {}  # per-engine breakdown

    # --- 1. Keyword Analysis ---
    ks, kw = keyword_score(f"{subject} {body}")
    total_score += ks
    if kw:
        reasons.append(f"Suspicious Keywords: {kw}")
    engines["keywords"] = {"score": ks, "hits": len(kw) if kw else 0}

    # --- 2. URL Inspection ---
    urls = extract_urls(body)
    url_total = 0
    for u in urls:
        us, ur = url_score(u)
        url_total += us
        total_score += us
        if ur:
            reasons.append(f"URL issue ({u}): {ur}")
    engines["urls"] = {"score": url_total, "count": len(urls)}

    # --- 3. Sender Verification ---
    ss, sr = sender_score(sender)
    total_score += ss
    if sr:
        reasons.append(f"Sender issue: {sr}")
    engines["sender"] = {"score": ss}

    # --- 4. Reply-To Mismatch ---
    reply_to_score = 0
    if msg and msg.get("Reply-To") and msg.get("Reply-To") != msg.get("From"):
        reply_to_score = 3
        total_score += reply_to_score
        reasons.append(f"Reply-To mismatch: From='{msg.get('From')}' vs Reply-To='{msg.get('Reply-To')}'")
    engines["reply_to"] = {"score": reply_to_score}

    # --- Automated detection systems ---

    # 5. WHOIS domain age
    checked_domains = set()
    sender_domain = extract_domain_from_sender(sender)
    if sender_domain and sender_domain not in suspicious_sender_domains:
        checked_domains.add(sender_domain)
    for u in urls:
        d = extract_domain_from_url(u)
        if d:
            checked_domains.add(d)

    whois_total = 0
    for domain in checked_domains:
        ws, wr = whois_domain_age(domain)
        whois_total += ws
        total_score += ws
        if wr:
            reasons.extend(wr)
    engines["whois"] = {"score": whois_total, "domains_checked": list(checked_domains)}

    # 6. Levenshtein typosquatting
    lev_total = 0
    for domain in checked_domains:
        ls, lr = levenshtein_domain_check(domain)
        lev_total += ls
        total_score += ls
        if lr:
            reasons.extend(lr)
    engines["levenshtein"] = {"score": lev_total}

    # 7. Shannon entropy
    ent_total = 0
    for domain in checked_domains:
        es, er = entropy_domain_check(domain)
        ent_total += es
        total_score += es
        if er:
            reasons.extend(er)
    engines["entropy"] = {"score": ent_total}

    # 8. Google Safe Browsing
    sb_total = 0
    if urls:
        sbs, sbr = safe_browsing_check(urls)
        sb_total = sbs
        total_score += sbs
        if sbr:
            reasons.extend(sbr)
    engines["safe_browsing"] = {"score": sb_total}

    # 9. Email header forensics (SPF/DKIM/DMARC)
    hfs, hfr = header_forensics(msg)
    total_score += hfs
    if hfr:
        reasons.extend(hfr)
    engines["header_forensics"] = {"score": hfs, "details": hfr}

    # Verdict
    if total_score >= 8:
        verdict = "PHISHING"
    elif total_score >= 4:
        verdict = "SUSPICIOUS"
    else:
        verdict = "SAFE"

    return {
        "score": total_score,
        "verdict": verdict,
        "reasons": reasons,
        "engines": engines,
        "sender_domain": sender_domain or "",
    }


@app.get("/")
def home():
    return FileResponse(str(BASE_DIR / "static" / "index.html"))


@app.get("/api/health")
def health():
    return {"status": "online", "message": "Phishing Detector is active."}


@app.post("/analyze")
def analyze(input: EmailInput):
    subject, sender, body, msg = parse_email(input.raw_email)
    return analyze_email(subject, sender, body, msg)


@app.get("/scan-gmail")
def scan_gmail(max_results: int = 5):
    emails = get_gmail_emails(max_results=min(max_results, 50))
    if not emails:
        return {"message": "No emails found or Auth failed. Check terminal."}

    results = []
    for e in emails:
        # Pass the mock message object for full header forensics
        mock_msg = e.get('_msg')
        res = analyze_email(e['subject'], e['sender'], e['body'], msg=mock_msg)
        results.append({
            "subject": e['subject'],
            "sender": e['sender'],
            "analysis": res,
        })
    return results


if __name__ == "__main__":
    uvicorn.run(app, host="127.0.0.1", port=8000)
