import dns.resolver
import Levenshtein
from bs4 import BeautifulSoup
from fastapi import FastAPI, HTTPException
from fastapi.staticfiles import StaticFiles
from fastapi.responses import FileResponse
from pydantic import BaseModel

# Google API Imports
from googleapiclient.discovery import build
from google_auth_oauthlib.flow import InstalledAppFlow
from google.auth.transport.requests import Request

logger = logging.getLogger(__name__)

# ─────────────────────────────────────────────
# CONFIG
# ─────────────────────────────────────────────
SCOPES = ['https://www.googleapis.com/auth/gmail.readonly']

WHITELISTED_DOMAINS = [
    "klh.edu.in",
]

BASE_DIR = Path(__file__).resolve().parent

app = FastAPI(title="Phishing Detector API")
app.mount("/static", StaticFiles(directory=str(BASE_DIR / "static")), name="static")


class EmailInput(BaseModel):
    raw_email: str


# ─────────────────────────────────────────────
# GMAIL AUTH
# ─────────────────────────────────────────────
def get_credentials():
    creds = None
    if os.path.exists('token.pickle'):
        with open('token.pickle', 'rb') as token:
            creds = pickle.load(token)

    if not creds or not creds.valid:
        if creds and creds.expired and creds.refresh_token:
            creds.refresh(Request())
        else:
            flow = InstalledAppFlow.from_client_secrets_file(
                'credentials.json', SCOPES
            )
            creds = flow.run_local_server(port=0)

        with open('token.pickle', 'wb') as token:
            pickle.dump(creds, token)
    return creds


SECURITY_HEADERS = [
    'Subject', 'From', 'Reply-To', 'Return-Path',
    'Authentication-Results', 'Received-SPF',
    'X-Spam-Status', 'X-Spam-Score',
    'DKIM-Signature', 'ARC-Authentication-Results',
]


def get_gmail_emails(max_results=5):
    try:
        creds = get_credentials()
        service = build('gmail', 'v1', credentials=creds)

        results = service.users().messages().list(userId='me', maxResults=max_results).execute()
        messages = results.get('messages', [])

        emails = []
        for msg in messages:
            txt = service.users().messages().get(userId='me', id=msg['id']).execute()
            payload = txt.get('payload', {})
            headers = payload.get('headers', [])

            header_dict = {}
            received_list = []
            for h in headers:
                if h['name'] == 'Received':
                    received_list.append(h['value'])
                else:
                    header_dict[h['name']] = h['value']

            subject = header_dict.get('Subject', 'No Subject')
            sender = header_dict.get('From', 'Unknown Sender')

            # Body extraction — both plain and HTML
            body_plain = ""
            body_html = ""

            def _extract_parts(part):
                nonlocal body_plain, body_html
                mime = part.get('mimeType', '')
                data = part.get('body', {}).get('data', '')
                if mime == 'text/plain' and data:
                    body_plain += base64.urlsafe_b64decode(data + '==').decode(errors='ignore')
                elif mime == 'text/html' and data:
                    body_html += base64.urlsafe_b64decode(data + '==').decode(errors='ignore')
                for sub in part.get('parts', []):
                    _extract_parts(sub)

            if 'parts' in payload:
                for part in payload['parts']:
                    _extract_parts(part)
            else:
                _extract_parts(payload)

            # Build mock email.message for header forensics
            mock_msg = message_from_string("")
            for hname in SECURITY_HEADERS:
                if hname in header_dict:
                    mock_msg[hname] = header_dict[hname]
            for recv in received_list:
                mock_msg['Received'] = recv

            # Extract attachment info
            attachments = []
            def _extract_attachments(part):
                filename = part.get('filename', '')
                if filename:
                    attachments.append({
                        'filename': filename,
                        'mimeType': part.get('mimeType', ''),
                        'size': int(part.get('body', {}).get('size', 0)),
                    })
                for sub in part.get('parts', []):
                    _extract_attachments(sub)

            if 'parts' in payload:
                for part in payload['parts']:
                    _extract_attachments(part)

            emails.append({
                "subject": subject,
                "sender": sender,
                "body": body_plain or body_html,
                "body_html": body_html,
                "attachments": attachments,
                "_msg": mock_msg,
            })
        return emails
    except Exception as e:
        print(f"Gmail Fetch Error: {e}")
        return []


