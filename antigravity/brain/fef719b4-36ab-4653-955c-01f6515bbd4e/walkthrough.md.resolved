def keyword_score(text):
    text_lower = text.lower()
    score = 0
    hits = []

    # Check suspicious words
    for word in suspicious_words:
        if word in text_lower:
            hits.append(word)
            score += 2

    # Check for impersonated brand names in the body/subject
    for brand in impersonated_brands:
        if brand in text_lower:
            hits.append(f"brand:{brand}")
            score += 1

    # Check urgency patterns via regex
    for pattern in urgency_patterns:
        if re.search(pattern, text_lower):
            hits.append(f"urgency_pattern")
            score += 3
            break  # count urgency once

    # ALL CAPS phrases (screaming = social engineering pressure)
    caps_words = re.findall(r'\b[A-Z]{4,}\b', text)
    if len(caps_words) >= 3:
        hits.append(f"excessive_caps({len(caps_words)} words)")
        score += 2

    # Exclamation marks overuse
    if text.count('!') >= 3:
        hits.append("excessive_exclamation_marks")
        score += 1

    return score, hits


def extract_urls(text):
    return re.findall(r'https?://\S+', text)


def url_score(url):
    score, reasons = 0, []
    url_lower = url.lower()

    if len(url) > 50:
        score += 1
        reasons.append("Long URL")
    if url.count('.') > 3:
        score += 1
        reasons.append("Excessive subdomains")
    if re.search(r'\d+\.\d+\.\d+\.\d+', url):
        score += 3
        reasons.append("IP address used instead of domain")
    if url.startswith("http://"):
        score += 2
        reasons.append("Insecure (No HTTPS)")

    # Check suspicious TLDs
    for tld in suspicious_tlds:
        if tld in url_lower:
            score += 2
            reasons.append(f"Suspicious TLD: {tld}")
            break

    # Check URL shorteners
    for shortener in url_shorteners:
        if shortener in url_lower:
            score += 2
            reasons.append(f"URL shortener used: {shortener}")
            break

    # URL encoding tricks (%xx characters used to hide real URL)
    encoded_chars = re.findall(r'%[0-9A-Fa-f]{2}', url)
    if len(encoded_chars) > 3:
        score += 2
        reasons.append(f"Excessive URL encoding ({len(encoded_chars)} encoded chars)")

    # @ symbol in URL (redirects to attacker-controlled domain)
    if '@' in url:
        score += 3
        reasons.append("@ symbol in URL (possible redirect trick)")

    # Lookalike domain detection (e.g. paypa1.com, micr0soft.com)
    for brand in impersonated_brands:
        # Check if domain looks like a brand but with character substitution
        domain_part = re.sub(r'https?://(www\.)?', '', url_lower).split('/')[0]
        if brand not in domain_part:
            # Simple l33t speak check
            normalized = domain_part.replace('0', 'o').replace('1', 'l').replace('3', 'e').replace('4', 'a').replace('5', 's')
            if brand in normalized and brand not in domain_part:
                score += 4
                reasons.append(f"Lookalike domain for '{brand}': {domain_part}")
                break

    return score, reasons


def sender_score(sender):
    score, reasons = 0, []
    sender_lower = sender.lower()

    if "@" not in sender:
        score += 3
        reasons.append("Invalid sender format (no @ symbol)")
        return score, reasons

    # Extract domain from sender
    domain = sender_lower.split("@")[-1].strip(">").strip()

    # Check if a brand name appears but sender uses freemail
    is_freemail = any(d in domain for d in suspicious_sender_domains)

    # Support/admin/security from freemail = huge red flag
    impersonation_words = ["support", "admin", "security", "help", "service",
                           "billing", "noreply", "no-reply", "alert", "notification",
                           "info", "helpdesk", "team", "official"]
    for word in impersonation_words:
        if word in sender_lower and is_freemail:
            score += 3
            reasons.append(f"'{word}' from freemail domain '{domain}'")
            break

    # Brand in display name but freemail domain
    for brand in impersonated_brands:
        if brand in sender_lower and is_freemail:
            score += 4
            reasons.append(f"Brand '{brand}' impersonation from freemail '{domain}'")
            break

    # Suspicious TLD in sender domain
    for tld in suspicious_tlds:
        if domain.endswith(tld.lstrip('.')):
            score += 2
            reasons.append(f"Sender uses suspicious TLD: {tld}")
            break

    # Random-looking sender (lots of numbers/gibberish)
    local_part = sender_lower.split("@")[0].strip("<").strip()
    digit_ratio = sum(c.isdigit() for c in local_part) / max(len(local_part), 1)
    if digit_ratio > 0.4 and len(local_part) > 5:
        score += 2
        reasons.append(f"Sender address looks auto-generated: {local_part}")

    return score, reasons


